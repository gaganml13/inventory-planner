.gitattributes
.env
.env.*
*.local

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Scratch & temporary files
scratch/
tmp/
.DS_Store
Thumbs.db
